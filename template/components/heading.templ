package components

// SectionHeading renders the small accent bar + bold mono title used to
// introduce every section on the page (Who Am I, Skills & Technologies,
// Experience, etc.) — kept as its own component so it stays identical
// everywhere instead of being re-styled per section.
templ SectionHeading(title string) {
	<div class="flex items-center justify-center gap-3">
		<span class="h-6 w-1 rounded-full bg-primary"></span>
		<h2 class="font-mono text-3xl font-bold text-foreground sm:text-4xl">{ title }</h2>
	</div>
}
