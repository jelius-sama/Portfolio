package pages

import (
	"fmt"
	"git.jelius.dev/jelius-sama/Portfolio/template/components"
)

templ Blogs() {
	<main id="blogs" class="mx-auto max-w-6xl px-3">
		@BlogsIntro()
		<div id="blog-section" class="flex flex-col py-2 gap-2">
			@BlogInfo("Newest", 5, 10, 1, 2)
			@BlogSortSelect("newest")
			@BlogPostsList(SampleBlogPosts[:5], true, 2, "newest")
		</div>
	</main>
}

templ BlogsIntro() {
	<div class="flex flex-col items-center text-center">
		<div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary">
			<svg class="h-7 w-7 text-primary-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 11a9 9 0 0 1 9 9"></path>
				<path d="M4 4a16 16 0 0 1 16 16"></path>
				<circle cx="5" cy="19" r="1"></circle>
			</svg>
		</div>
		<h1 class="mt-6 font-mono text-3xl font-bold text-foreground sm:text-4xl">My Blog Posts</h1>
		<p class="mt-3 text-muted-foreground">Explore my thoughts on development and technology</p>
	</div>
}

// BlogInfo renders the "blog-info" terminal. Since the list is
// server-rendered with real data from the start (no client fetch on
// first load), this always shows the real counts — no loading state.
//
// The three inner <p> ids (blog-info-status/-sort/-displaying/-pages)
// are OOB swap targets: when more posts are loaded via
// BlogLoadMoreTrigger, have that handler's response also include
// @BlogInfoOOBUpdate(...) so these numbers stay in sync — see that
// component's doc comment for the exact response shape.
templ BlogInfo(sortLabel string, displayed, total, loadedPages, totalPages int) {
	@components.Terminal("blog-info") {
		<div class="space-y-4">
			<div>
				<p>
					<span class="text-primary">$</span>
					<span class="text-foreground">ls /var/www/blogs/posts/</span>
				</p>
				<p id="blog-info-status" class="text-muted-foreground">{ fmt.Sprintf("Found %d articles.", total) }</p>
			</div>
			<div>
				<p>
					<span class="text-primary">$</span>
					<span class="text-foreground">cat /etc/blog-config.conf</span>
				</p>
				<p id="blog-info-sort" class="text-muted-foreground">{ fmt.Sprintf("Sort by: %s", sortLabel) }</p>
				<p id="blog-info-displaying" class="text-muted-foreground">{ fmt.Sprintf("Displaying: %d of %d", displayed, total) }</p>
				<p id="blog-info-pages" class={ "text-muted-foreground", templ.KV("hidden", loadedPages == 0) }>
					{ fmt.Sprintf("Loaded pages: %d of %d", loadedPages, totalPages) }
				</p>
			</div>
		</div>
	}
}

// BlogInfoOOBUpdate renders the same three lines as BlogInfo, each
// carrying hx-swap-oob="true" so htmx updates them in place by id —
// include this in the response returned to BlogLoadMoreTrigger's
// hx-get, alongside the new post rows and the next primary-target
// content (see blog_posts_list.templ for the full contract).
templ BlogInfoOOBUpdate(sortLabel string, displayed, total, loadedPages, totalPages int) {
	<p id="blog-info-status" hx-swap-oob="true" class="text-muted-foreground">{ fmt.Sprintf("Found %d articles.", total) }</p>
	<p id="blog-info-sort" hx-swap-oob="true" class="text-muted-foreground">{ fmt.Sprintf("Sort by: %s", sortLabel) }</p>
	<p id="blog-info-displaying" hx-swap-oob="true" class="text-muted-foreground">{ fmt.Sprintf("Displaying: %d of %d", displayed, total) }</p>
	<p id="blog-info-pages" hx-swap-oob="true" class="text-muted-foreground">{ fmt.Sprintf("Loaded pages: %d of %d", loadedPages, totalPages) }</p>
}

// BlogSortSelect renders the sort dropdown, wired to reload the blog
// section on change via htmx.
//
// ASSUMPTION: targets an element with id="blog-section" wrapping
// BlogInfo + BlogPostsList — wrap those two in a
// <div id="blog-section"> when you assemble the page, or change the
// hx-target below to whatever container you actually use.
templ BlogSortSelect(current string) {
	<div class="flex justify-end">
		<div class="relative">
			<select
				id="blog-sort"
				name="sort"
				hx-get="/api/blogs?page=1"
				hx-trigger="change"
				hx-target="#blog-section"
				hx-swap="innerHTML"
				hx-include="this"
				class="appearance-none rounded-md border border-border bg-card py-2 pl-4 pr-9 font-mono text-sm text-foreground transition-colors hover:border-primary/40 focus:outline-none focus:ring-2 focus:ring-ring"
			>
				<option value="newest" selected?={ current == "newest" }>Sort by: Newest</option>
				<option value="oldest" selected?={ current == "oldest" }>Sort by: Oldest</option>
				<option value="popular" selected?={ current == "popular" }>Sort by: Most Viewed</option>
			</select>
			<svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="m6 9 6 6 6-6"></path>
			</svg>
		</div>
	</div>
}

// BlogPost is one entry in the blog list.
type BlogPost struct {
	Title     string
	Excerpt   string
	Slug      string
	Published string
	Updated   string
	Views     int
}

// SampleBlogPosts is hardcoded placeholder data — swap the handler that
// calls BlogPostsList/BlogInfo over to a real DB-backed source later;
// nothing in these components needs to change when you do.
var SampleBlogPosts = []BlogPost{
	{Title: "Caveats & Workarounds — OpenMediaCloud", Excerpt: "Architectural Workarounds for Compute-Dependent Features", Slug: "caveats-workarounds-openmediacloud", Published: "May 11, 2026 at 01:14 PM", Updated: "May 11, 2026 at 07:47 AM", Views: 13},
	{Title: "Setup Guide — OpenMediaCloud", Excerpt: "This guide walks you through setting up OpenMediaCloud on a Linux server", Slug: "setup-guide-openmediacloud", Published: "May 11, 2026 at 01:02 PM", Updated: "May 11, 2026 at 07:47 AM", Views: 12},
	{Title: "A Proxy that cuts my Jellyfin Hosting costs by 80%", Excerpt: "Say goodbye to egress costs", Slug: "proxy-cuts-jellyfin-hosting-costs", Published: "April 3, 2026 at 08:32 PM", Updated: "May 11, 2026 at 07:47 AM", Views: 55},
	{Title: "Safari Is a Dumpster Fire and Apple Knows It", Excerpt: "Safari is not \"privacy-focused brilliance.\" — It's a broken, inconsistent, developer-hostile piece of shit.", Slug: "safari-is-a-dumpster-fire", Published: "February 13, 2026 at 02:33 PM", Updated: "", Views: 18},
	{Title: "Convert Folders to CBZ Archives with \"convert-cbz\" — Fast, Cross-Platform Comic Converter", Excerpt: "A powerful, cross-platform tool for converting directory of folders of images into CBZ comic book archives. \"convert-cbz\" helps you to quickly create clean, organized CBZ files for your entire comic or manga library.", Slug: "convert-cbz", Published: "September 22, 2025 at 12:59 PM", Updated: "November 16, 2025 at 08:59 AM", Views: 601},
	{Title: "Email Done Right: My End-to-End Journey from Gmail to AWS SES — Part 3", Excerpt: "Getting SES production access, cleaning up configs, and finally sending emails that look truly professional.", Slug: "email-done-right-part-3", Published: "August 23, 2025 at 08:09 PM", Updated: "August 23, 2025 at 02:51 PM", Views: 24},
	{Title: "Email Done Right: My End-to-End Journey from Gmail to AWS SES — Part 2", Excerpt: "Setting up AWS SES, DNS records, and testing email flow while dealing with sandbox restrictions.", Slug: "email-done-right-part-2", Published: "August 23, 2025 at 08:08 PM", Updated: "August 23, 2025 at 02:51 PM", Views: 22},
	{Title: "Email Done Right: My End-to-End Journey from Gmail to AWS SES — Part 1", Excerpt: "Why Gmail's \"sent via\" headers and limits pushed me to find a professional email-sending solution.", Slug: "email-done-right-part-1", Published: "August 23, 2025 at 08:04 PM", Updated: "August 23, 2025 at 02:51 PM", Views: 30},
	{Title: "Hello World — I'm Jelius", Excerpt: "A quick introduction to who I am, what I do, and why I build. Meet the mind behind jelius.dev.", Slug: "hello-world-im-jelius", Published: "July 21, 2025 at 08:24 PM", Updated: "", Views: 73},
}

// BlogPostItem renders one row: title + excerpt, an arrow icon, and a
// Published/Views/Updated meta line — matches the card row pattern used
// elsewhere on the site (SkillItem, LinkItem).
//
// Uses @Link so it goes through the same htmx routing as the rest of
// the site. Note: LinkAttr only exposes Href/Class/Id, so unlike
// TerminalLine/SkillItem this can't stagger its entrance animation by
// index — every row uses the same fixed fade/slide-in instead.
templ BlogPostItem(post BlogPost) {
	@components.Link(components.LinkAttr{
		Href:  "/blogs/" + post.Slug,
		Class: "group flex flex-col gap-4 rounded-md border border-border bg-card px-6 py-5 transition-colors hover:border-primary/40 animate-in fade-in slide-in-from-bottom-1 fill-mode-both duration-500 ease-out motion-reduce:animate-none",
	}) {
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<h3 class="font-mono text-lg font-semibold text-foreground transition-colors group-hover:text-primary">
					{ post.Title }
				</h3>
				if post.Excerpt != "" {
					<p class="mt-1 text-sm text-muted-foreground">{ post.Excerpt }</p>
				}
			</div>
			<svg class="mt-1 h-5 w-5 shrink-0 text-muted-foreground transition-colors group-hover:text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M5 12h14"></path>
				<path d="m13 6 6 6-6 6"></path>
			</svg>
		</div>
		<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1 font-mono text-xs text-muted-foreground">
			<div class="space-y-1">
				<p>{ fmt.Sprintf("Published: %s", post.Published) }</p>
				<p>{ fmt.Sprintf("Views: %d", post.Views) }</p>
			</div>
			if post.Updated != "" {
				<p>{ fmt.Sprintf("Updated: %s", post.Updated) }</p>
			}
		</div>
	}
}

var blogScript = templ.NewOnceHandle()

// BlogPostsList renders the "blog-posts" terminal with real (currently
// hardcoded) rows from the start — no loading skeleton, since this is
// server-rendered. Below the terminal sits either a BlogLoadMoreTrigger
// (if hasMore) or a static BlogEndOfPosts marker.
templ BlogPostsList(posts []BlogPost, hasMore bool, nextPage int, sort string) {
	@components.Terminal("blog-posts") {
		<div id="blog-posts-list" class="space-y-4">
			for _, post := range posts {
				@BlogPostItem(post)
			}
		</div>
	}
	if hasMore {
		@BlogLoadMoreTrigger(nextPage, sort)
	} else {
		@BlogEndOfPosts()
	}
	@blogErrorHandlerScript()
}

// BlogLoadMoreTrigger is the infinite-scroll sentinel: as soon as it
// scrolls into view, hx-trigger="revealed" fires the request. It carries
// the "blog-load-trigger" class so the response-error handler below can
// find it regardless of whether it's the original trigger or a retry
// button rendered in its place.
//
// RESPONSE CONTRACT (server-side, once the real endpoint exists) — for
// GET /api/blogs?page={nextPage}&sort={sort}, return all of the
// following concatenated in one HTML response:
//  1. @BlogPostsOOB(newPosts)               — appends the new rows
//  2. @BlogInfoOOBUpdate(sortLabel, ...)     — updates the count lines
//  3. Either @BlogLoadMoreTrigger(next+1, sort) if more pages remain,
//     or @BlogEndOfPosts() if this was the last page — this becomes the
//     primary swap (hx-target="this", hx-swap="outerHTML") replacing
//     this element.
// On error, return the ErrorResp JSON with a non-2xx status — the
// script below intercepts that via htmx:responseError and swaps in a
// retry card instead of trying to swap non-HTML content.
templ BlogLoadMoreTrigger(page int, sort string) {
	<div
		class="blog-load-trigger mt-8 text-center text-sm text-muted-foreground"
		hx-get={ fmt.Sprintf("/api/blogs?page=%d&sort=%s", page, sort) }
		hx-trigger="revealed"
		hx-swap="outerHTML"
		hx-target="this"
	>
		Loading more posts...
	</div>
}

// BlogEndOfPosts is the static marker shown once there's nothing left
// to load — either as the initial render (hasMore=false) or as the
// final primary-swap response from BlogLoadMoreTrigger's last page.
templ BlogEndOfPosts() {
	<p class="mt-8 text-center text-sm text-muted-foreground">End of posts.</p>
}

// BlogPostsOOB wraps each new post in a `display: contents` div carrying
// hx-swap-oob="beforeend:#blog-posts-list" — `contents` keeps the
// wrapper out of the box model entirely so the appended rows still sit
// flush in the list's own space-y-4, rather than nesting inside an
// extra visible box. (Needed because LinkAttr doesn't expose a way to
// put hx-swap-oob directly on BlogPostItem's own <a> tag.)
templ BlogPostsOOB(posts []BlogPost) {
	for _, post := range posts {
		<div class="contents" hx-swap-oob="beforeend:#blog-posts-list">
			@BlogPostItem(post)
		</div>
	}
}

// blogErrorHandlerScript listens for failed blog-load-trigger requests
// and swaps in a themed error + retry card, since the error response
// (ErrorResp JSON) isn't HTML htmx can swap in directly. Rendered once
// per page regardless of how many times BlogPostsList is called.
templ blogErrorHandlerScript() {
	@blogScript.Once() {
		<script>
			document.body.addEventListener('htmx:responseError', (evt) => {
				const trigger = evt.target.closest('.blog-load-trigger');
				if (!trigger) return;

				let message = 'Something went wrong loading posts.';
				try {
					const body = JSON.parse(evt.detail.xhr.responseText);
					if (body && body.message) message = body.message;
				} catch (e) {
					// non-JSON error body — fall back to the default message
				}

				const href = trigger.getAttribute('hx-get');

				const card = document.createElement('div');
				card.className = 'blog-load-trigger flex flex-col items-center gap-3 rounded-md border border-[#f38ba8]/40 bg-card px-6 py-5 text-center';

				const text = document.createElement('p');
				text.className = 'font-mono text-sm text-[#f38ba8]';
				text.textContent = message;
				card.appendChild(text);

				const retry = document.createElement('button');
				retry.type = 'button';
				retry.className = 'rounded-md border border-border px-4 py-1.5 font-mono text-xs font-semibold text-foreground transition-colors hover:bg-accent';
				retry.textContent = 'Retry';
				retry.setAttribute('hx-get', href);
				retry.setAttribute('hx-trigger', 'click');
				retry.setAttribute('hx-swap', 'outerHTML');
				retry.setAttribute('hx-target', 'this');
				card.appendChild(retry);

				trigger.replaceWith(card);
				htmx.process(card);
			});
		</script>
	}
}
