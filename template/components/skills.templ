package components

import "fmt"

// skillAccentDots cycles a small set of Catppuccin accent colors across
// skill items so each row gets a distinct dot without hand-picking one
// per item. Purely decorative — same accent set used for the terminal's
// traffic-light dots elsewhere.
var skillAccentDots = []string{"#89b4fa", "#f9e2af", "#a6e3a1", "#cba6f7", "#fab387", "#94e2d5"}

func skillDotClass(index int) string {
	return fmt.Sprintf("bg-[%s]", skillAccentDots[index%len(skillAccentDots)])
}

// Skills renders the "Skills & Technologies" section: a heading, a short
// subtitle, and three columns (Languages / Frameworks / Others) built from
// the reusable SkillColumn + SkillItem components below.
//
// Hardcoded entries below — swap for real data / a props struct later.
templ Skills() {
	<section id="skills" class="bg-background px-6 py-24 sm:py-32">
		<div class="mx-auto max-w-5xl">
			@SectionHeading("Skills & Technologies")
			<p class="mt-4 text-center text-sm text-muted-foreground">
				Technologies and tools I work with:
			</p>
			<div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-8">
				@SkillColumn("Languages") {
					@SkillItem(0, "Rust")
					@SkillItem(1, "Swift")
					@SkillItem(2, "C")
					@SkillItem(3, "Go")
					@SkillItem(4, "TypeScript")
				}
				@SkillColumn("Frameworks") {
					@SkillItem(0, "Node.js")
					@SkillItem(1, "Svelte")
					@SkillItem(2, "SolidJS")
					@SkillItem(3, "React")
					@SkillItem(4, "Next.js")
				}
				@SkillColumn("Others") {
					@SkillItem(0, "AWS")
					@SkillItem(1, "Cloudflare")
					@SkillItem(2, "PostgreSQL")
					@SkillItem(3, "Redis")
					@SkillItem(4, "Git")
				}
			</div>
		</div>
	</section>
}

// SkillColumn renders one labeled column of skill rows. Pass SkillItem
// calls as children.
templ SkillColumn(title string) {
	<div>
		<h3 class="font-mono text-sm font-semibold uppercase tracking-wide text-primary">
			{ title }
		</h3>
		<ul class="mt-4 space-y-2.5">
			{ children... }
		</ul>
	</div>
}

// SkillItem renders one skill row: a colored dot + name. index picks the
// dot color (see skillAccentDots) and also staggers the row's fade/slide-in
// via lineDelay, reused from terminal.templ so both components animate on
// the same rhythm.
templ SkillItem(index int, name string) {
	<li class={ "flex items-center gap-2.5 rounded-md border border-border bg-card px-4 py-2.5 transition-colors hover:border-primary/40 animate-in fade-in slide-in-from-bottom-1 fill-mode-both duration-500 ease-out motion-reduce:animate-none", lineDelay(index) }>
		<span class={ "h-2 w-2 shrink-0 rounded-full", skillDotClass(index) }></span>
		<span class="font-mono text-sm text-foreground">{ name }</span>
	</li>
}
