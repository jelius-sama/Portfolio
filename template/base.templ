package template

templ Base(metadata templ.Component, body templ.Component, footer templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			if metadata != nil {
				@metadata
			}
		</head>
		<body>
			if body != nil {
				@body
			}
			if footer != nil {
				@footer
			}
			@HTMXScript()
		</body>
	</html>
}
