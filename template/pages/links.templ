package pages

import "git.jelius.dev/jelius-sama/Portfolio/template/components"

// TODO: Make width consistent across components
templ Links() {
	<main id="links">
		@components.AuroraBackdrop()
		@ProfileHandle("/assets/img/avatar.jpg", "Portrait of Jelius Basumatary", "jelius_sama", "Undergraduate Student • Open Source Enthusiast")
		<div class="mx-auto max-w-6xl px-6">
			@components.SocialLinksList()
			@components.LinksOutro()
		</div>
	</main>
}

// ProfileHandle renders the avatar + @handle + tagline intro block used
// at the top of the /links page — same ambient-glow + AvatarRing
// treatment as Hero, just trimmed down to identity only (no bio, no
// CTAs, no terminal).
templ ProfileHandle(avatarSrc, avatarAlt, handle, tagline string) {
	<section class="relative isolate overflow-hidden px-6 pt-20 pb-10 sm:pt-28">
		<!-- ambient glow, same treatment as Hero's -->
		<div
			class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[32rem] w-[64rem] -translate-x-1/2 -translate-y-1/3 rounded-full bg-primary/10 blur-3xl"
			aria-hidden="true"
		></div>
		<div class="mx-auto flex max-w-2xl flex-col items-center text-center">
			@components.AvatarRing(avatarSrc, avatarAlt)
			<h1 class="mt-6 font-mono text-2xl font-bold text-foreground sm:text-3xl">
				<span class="text-primary">{ string(rune(0x40)) }</span>{ handle }
			</h1>
			<p class="mt-2 text-sm text-muted-foreground">
				{ tagline }
			</p>
		</div>
	</section>
}
